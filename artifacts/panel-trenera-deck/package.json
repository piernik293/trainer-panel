{
  "name": "@workspace/panel-trenera-deck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=${PORT:-24000} BASE_PATH=${BASE_PATH:-/} vite --config vite.config.ts --host 0.0.0.0",
    "build": "PORT=${PORT:-24000} BASE_PATH=${BASE_PATH:-/} vite build --config vite.config.ts",
    "serve": "PORT=${PORT:-24000} BASE_PATH=${BASE_PATH:-/} vite preview --config vite.config.ts --host 0.0.0.0",
    "validate-slides": "pnpm exec tsx scripts/validate-slides.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
