# Szablon .env produkcyjnego (PRZYGOTOWANE). Wartości WPISUJE WŁAŚCICIEL; tu są tylko nazwy. Plik 600, poza repozytorium.
DATABASE_URL=postgres://UŻYTKOWNIK:HASŁO@localhost:5432/trainer_panel_prod
NODE_ENV=production
PORT=8080
CLERK_PUBLISHABLE_KEY=            # z panelu Clerk, instancja PRODUCTION
CLERK_SECRET_KEY=                 # j.w. — nigdy do repozytorium
TRAINER_APP_ORIGIN=https://panel.example.pl
CLIENT_PORTAL_ORIGIN=https://panel.example.pl
TRUST_PROXY=loopback
HSTS_ENABLED=1
CSP_ENFORCE=0                     # zmień na 1 po czystym przebiegu w trybie „tylko raport”
# Role (właściciel)
ADMIN_CLERK_IDS=
TRAINER_CLERK_IDS=                # lista awaryjna; docelowo role z wniosków
# Poczta (darmowy próg wybranej usługi) — wpisz dopiero po założeniu konta
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
