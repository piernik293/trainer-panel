# Szablon zmiennych dla uruchomienia poza Replit (GCP VM).
# Skopiuj do .env i uzupełnij. NIE commituj pliku .env.
# Wczytanie do powłoki:  set -a; . ./.env; set +a

# ── Baza danych (wymagane) ──────────────────────────────────────────────
DATABASE_URL=

# ── API server ──────────────────────────────────────────────────────────
# PORT ustawiany per proces (API: 8080). Frontendy mają własne PORT/BASE_PATH.
NODE_ENV=development
LOG_LEVEL=info

# ── Clerk (instancja development) ───────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Opcjonalne — tylko gdy używany jest proxy Clerk (/api/__clerk, produkcja)
VITE_CLERK_PROXY_URL=

# ── CORS (wymagane w produkcji; lokalnie opcjonalne) ────────────────────
# Konta trenerów zakłada administrator: lista identyfikatorów Clerk (po przecinku). TRAINER_SIGNUP_OPEN=1 tylko do developmentu i testu dymnego.
TRAINER_CLERK_IDS=
TRAINER_SIGNUP_OPEN=
TRAINER_APP_ORIGIN=
CLIENT_PORTAL_ORIGIN=
LOCAL_TRAINER_APP_ORIGIN=
LOCAL_CLIENT_PORTAL_ORIGIN=

# ── Vite dev: przekierowanie /api do API servera ────────────────────────
LOCAL_API_SERVER_URL=http://localhost:8080
# Panel trenera przekazuje /client-landing do dev servera portalu (jeden origin
# jak w Replit). Domyślnie ustawiane przez scripts/dev-gcp.sh.
LOCAL_CLIENT_PORTAL_DEV_URL=http://localhost:22347

# ── Uprawnienia administracyjne (Clerk user ID, po przecinku) ───────────
APP_ADMIN_CLERK_IDS=
CATALOGUE_ADMIN_CLERK_IDS=

# ── Adres publiczny aplikacji (linki w e-mailach z zaproszeniami) ───────
# Nie jest brany z nagłówków żądania. Domyślnie http://localhost:23889.
APP_PUBLIC_URL=http://localhost:23889

# ── E-mail (opcjonalne; bez nich wysyłka e-mailem jest niedostępna) ─────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=twoj@gmail.com,
# SMTP_PASS=hasło aplikacji (16 znaków, bez spacji), opcjonalnie SMTP_FROM.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_EMAIL=

# ── Tylko testy ─────────────────────────────────────────────────────────
TEST_SESSION_COOKIE=

# „Zgłoś uwagę” (domyślnie wyłączone; 1 = włączone). Uwagi czyta administrator w panelu (zakładka „Uwagi”).
FEEDBACK_ENABLED=
# Adres właściciela dla powiadomień (nowa uwaga, awarie). Gdy pusty, używane jest ADMIN_EMAIL.
OWNER_NOTIFY_EMAIL=

# Beta bez limitów planu Free (domyślnie wyłączone; 1 = trenerzy bez limitów klientów, automatycznych planów i własnych ćwiczeń).
BETA_NO_LIMITS=

# Adres kontaktowy pokazywany na ekranie „Poproś o dostęp trenera” (wartość bez @, np. TU_ADRES = nieustawiony).
CONTACT_EMAIL=TU_ADRES
